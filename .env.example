# ============================================================
# ServiceDesk Environment Configuration Template
# ============================================================

# Application Environment
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/servicedesk

# JWT Security Secrets (Must be 32+ characters in production)
JWT_ACCESS_SECRET=servicedesk_jwt_access_secret_2026_dev_key
JWT_REFRESH_SECRET=servicedesk_jwt_refresh_secret_2026_dev_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8443

# Logging & Observability
LOG_LEVEL=info
ENABLE_OTEL=false

# AI Assistance Service (Optional: Google Gemini API Key)
GEMINI_API_KEY=

# Supabase Client Configuration (Optional Frontend Live Cloud Connection)
VITE_SUPABASE_URL=https://mbykciicmzuwosyalmyx.supabase.co
